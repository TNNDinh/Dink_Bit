generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum DebtType {
  RECEIVABLE
  PAYABLE
}
enum UserRole {
  USER
  ADMIN
}
enum IntegrationScope {
  READ
  WRITE
}
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  OTHER
}
model User {
  id             String @id @default(cuid())
  name           String?
  email          String @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole @default(USER)
  sessionVersion Int @default(0)
  reminderDays   Int @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  accounts       Account[]
  sessions       Session[]
  contacts       Contact[]
  debts          Debt[]
  transactions   Transaction[]
  reminders      Reminder[]
  attachments    Attachment[]
  notifications  Notification[]
  passwordResets PasswordReset[]
  integrationKeys IntegrationKey[]
}
model IntegrationKey {
  id             String @id @default(cuid())
  userId         String
  name           String
  tokenHash      String @unique
  prefix         String
  scopes         IntegrationScope[]
  sessionVersion Int
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests       IntegrationRequest[]
  @@index([userId, createdAt])
}
model IntegrationRequest {
  id        String @id @default(cuid())
  keyId     String
  requestId String
  inputHash String
  response  Json
  createdAt DateTime @default(now())
  key       IntegrationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  @@unique([keyId, requestId])
}
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id           String @id @default(cuid())
  sessionToken String @unique
  userId       String
  expires      DateTime
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime
  @@unique([identifier, token])
}
model Contact {
  id           String @id @default(cuid())
  userId       String
  name         String
  phone        String @default("")
  email        String @default("")
  note         String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  debts        Debt[]
  transactions Transaction[]
  @@index([userId, name])
}
model Debt {
  id           String @id @default(cuid())
  userId       String
  contactId    String
  type         DebtType
  title        String
  description  String @default("")
  totalAmount  BigInt
  paidAmount   BigInt @default(0)
  createdDate  DateTime @db.Date
  dueDate      DateTime? @db.Date
  note         String @default("")
  cancelled    Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact      Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  activities   Activity[]
  reminders    Reminder[]
  attachments  Attachment[]
  @@index([userId, createdDate])
  @@index([userId, dueDate])
  @@index([userId, contactId])
}
model Transaction {
  id              String @id @default(cuid())
  userId          String
  debtId          String
  contactId       String
  type            DebtType
  amount          BigInt
  paymentMethod   PaymentMethod
  transactionDate DateTime @db.Date
  note            String @default("")
  requestId       String @unique
  createdAt       DateTime @default(now())
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt            Debt @relation(fields: [debtId], references: [id], onDelete: Restrict)
  contact         Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  @@index([userId, transactionDate])
}
model Activity {
  id        String @id @default(cuid())
  debtId    String
  kind      String
  message   String
  amount    BigInt?
  createdAt DateTime @default(now())
  debt      Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
}
model Reminder {
  id           String @id @default(cuid())
  userId       String
  debtId       String
  reminderDate DateTime @db.Date
  completed    Boolean @default(false)
  createdAt    DateTime @default(now())
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt         Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  @@unique([debtId, reminderDate])
  @@index([userId, reminderDate])
}
model Attachment {
  id        String @id @default(cuid())
  userId    String
  debtId    String
  fileName  String
  fileKey   String @unique
  fileType  String
  size      Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  debt      Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  @@index([userId, debtId])
}
model Notification {
  id        String @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  debtId    String?
  read      Boolean @default(false)
  dedupeKey String? @unique
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model PasswordReset {
  id        String @id @default(cuid())
  userId    String
  tokenHash String @unique
  expiresAt DateTime
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model RateLimit {
  key       String @id
  count     Int @default(1)
  expiresAt DateTime
}
